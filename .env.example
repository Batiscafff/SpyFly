# VirusTotal API key — https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Shodan API key — https://account.shodan.io
SHODAN_API_KEY=your_shodan_api_key_here

# AbuseIPDB API key — https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# NVD API key (optional, increases rate limit) — https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Flask secret key (change in production)
SECRET_KEY=dev-secret-change-me

# Directories for scan data and reports (relative to project root)
SCANS_DIR=scans
REPORTS_DIR=reports
